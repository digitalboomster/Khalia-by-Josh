# Database
DATABASE_URL=postgresql://user:password@localhost:5432/khalia_db
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# Redis
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# Server
NODE_ENV=development
PORT=3000
HOST=localhost
API_BASE_URL=http://localhost:3000

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Encryption
ENCRYPTION_KEY=your-aes-256-encryption-key-32-chars
ENCRYPTION_IV_LENGTH=16

# Payment Gateway
PAYSTACK_PUBLIC_KEY=pk_test_xxxxx
PAYSTACK_SECRET_KEY=sk_test_xxxxx
PAYSTACK_WEBHOOK_SECRET=webhook_secret_xxx

# BVN/NIN Verification
BVN_PROVIDER_API_KEY=xxx
BVN_PROVIDER_ENDPOINT=https://api.bvn-provider.ng

# Bank Settlement
BANK_ACCOUNT_NAME=Khalia Services Ltd
BANK_ACCOUNT_NUMBER=0123456789
BANK_CODE=050
NACCS_API_KEY=xxx

# Email Service
EMAIL_PROVIDER=mailgun
MAILGUN_API_KEY=key-xxx
MAILGUN_DOMAIN=mg.khalia.ng
FROM_EMAIL=noreply@khalia.ng

# Logging
LOG_LEVEL=debug
LOG_TRANSPORTS=console,file

# Security
BCRYPT_ROUNDS=12
SESSION_COOKIE_EXPIRY=1800000

# External Services
SENTRY_DSN=
DATADOG_API_KEY=

# Feature Flags
ENABLE_REAL_PAYMENTS=false
ENABLE_BVN_VERIFICATION=false
ENABLE_AUDIT_LOGGING=true

# Admin
ADMIN_EMAIL=admin@khalia.ng

# Monitoring
UPTIME_CHECK_INTERVAL_MS=60000
